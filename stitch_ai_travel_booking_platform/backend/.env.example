DATABASE_URL=sqlite:///./travel.db
SECRET_KEY=change-me-use-32+random-bytes
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173
# Google Identity Services: OAuth client type "Web application".
# Authorized JavaScript origins: http://127.0.0.1:8088 and/or http://localhost:5173
# Add the exact HTTPS deployment origin when deployed. This ID-token flow needs no client secret.
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
# false for local HTTP only; true for HTTPS deployment.
COOKIE_SECURE=false
# Optional local-only account while Google setup is pending; leave false on deployment.
DEV_LOGIN_ENABLED=false
# Optional hosted judge access: requires secure cookies and an exact HTTPS website origin.
JUDGE_DEMO_ENABLED=false
JUDGE_DEMO_ORIGINS=
MEMORY_SERVICE_URL=
MEMORY_SERVICE_TOKEN=
# Optional PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://voyara:password@localhost:5432/voyara
# The web process now owns the connected travel-agent/memory runtime.
# AGENT_MEMORY_PATH may override the private data/voyara_memory directory.
CONTEXT_USE_GPU=false
# Supply both only when binding an actual consumer tokenizer:
# CONTEXT_TOKENIZER_PATH=C:/path/to/tokenizer.json
# CONTEXT_TOKENIZER_ID=consumer-model-and-revision

# Read-only grant for the separate memory dashboard backend (minimum 32 chars).
# No data is published unless a valid grant and an explicit user are configured.
DASHBOARD_PUBLISH_TOKEN=
DASHBOARD_USER_ID=
# Optional: empty monitors all shared memory for the chosen user; set to one trip ID to narrow.
DASHBOARD_TRIP_ID=
