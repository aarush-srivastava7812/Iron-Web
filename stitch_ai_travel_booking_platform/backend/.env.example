DATABASE_URL=sqlite:///./travel.db
SECRET_KEY=change-me-use-32+random-bytes
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173
MEMORY_SERVICE_URL=
MEMORY_SERVICE_TOKEN=
# Optional PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://voyara:password@localhost:5432/voyara
# The web process now owns the connected travel-agent/memory runtime.
# AGENT_MEMORY_PATH may override the private data/voyara_memory directory.
CONTEXT_USE_GPU=false
# Supply both only when binding an actual consumer tokenizer:
# CONTEXT_TOKENIZER_PATH=C:/path/to/tokenizer.json
# CONTEXT_TOKENIZER_ID=consumer-model-and-revision
