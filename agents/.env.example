# Iron Web — agents environment
# NVIDIA API key: paste your key manually after the equals sign (do not commit the real key)
NVIDIA_API_KEY=
# Optional model override (default: openai/gpt-oss-20b — verified live on NIM)
# NIM_MODEL=openai/gpt-oss-20b
# NIM_AGENT_MODEL=openai/gpt-oss-20b
# NIM_AGENT_PROTOCOL=json
# VOYARA_AGENT_MODE=auto
# VOYARA_AGENT_MAX_TURNS=5

# Local TinyFish research: enable with run_voyara.py --agent-mode tinyfish
# Keep real keys in the ignored agents/.env file. Private trip memory stays local.
TINYFISH_API_KEY=
# TINYFISH_TIMEOUT_S=480

# Travel app backend (used by the agents to reach the live catalog / bookings API)
TRAVEL_API_URL=http://127.0.0.1:8000
TRAVEL_API_TOKEN=

# Agent service settings
AGENTS_HOST=127.0.0.1
AGENTS_PORT=8100
AGENTS_LOG_LEVEL=INFO
