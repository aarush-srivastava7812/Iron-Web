# Server-only: URL of the WEBSITE backend, never the dashboard backend itself.
DASHBOARD_SOURCE_URL=http://127.0.0.1:8000
# Must match DASHBOARD_PUBLISH_TOKEN on the website backend (at least 32 chars).
DASHBOARD_SOURCE_TOKEN=
DASHBOARD_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Separate server-held viewer credential, at least 32 random characters.
# Optional only on loopback; remote requests fail closed without it.
DASHBOARD_VIEWER_TOKEN=
